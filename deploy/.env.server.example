# Backend environment for the VPS.
# Copy to the project root as `.env` on the server and fill in real values.
#
#   cp deploy/.env.server.example .env
#
# Do NOT commit the real .env (it is already gitignored), and chmod 600 it —
# it now holds the database password and the token signing key.

# =============================================================================
# REQUIRED — the server exits at startup without these
# =============================================================================

# Postgres connection. See deploy/POSTGRES.md for creating the role and database.
# URL-encode any of @ : / ? # [ ] % that appear in the password.
DATABASE_URL=postgres://wa_app:password@127.0.0.1:5432/wa_app

# Signs access tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Treat this like a private key. Changing it signs every user out immediately,
# so it must stay stable across restarts and deploys.
JWT_SECRET=

# =============================================================================
# Server
# =============================================================================

# Port the Node process listens on (nginx proxies to this).
PORT=5000

# Bind address. Keep 127.0.0.1 behind nginx so the app is not directly
# reachable from the internet. Use 0.0.0.0 only inside a container.
HOST=127.0.0.1

NODE_ENV=production

# Browser origins allowed to call this API. Comma-separated, no trailing slash.
# REQUIRED in production — leaving this unset allows every origin.
# For a single-origin deployment this is your app's own URL.
CORS_ORIGIN=https://app.omnireach.my.id

# Public origin of the deployed app. Used as the post-payment return URL when a
# request carries no Referer.
PUBLIC_URL=https://app.omnireach.my.id

# =============================================================================
# Admin access
# =============================================================================

# Addresses that are given the admin role when they register. Comma-separated.
# owner@admin.com and adminthelab@gmail.com are built in.
#
# Note: the FIRST account ever registered becomes an approved admin regardless,
# so a fresh deployment is usable without editing the database. After that,
# admins come from this list or from promotion in the Customers tab.
#
# Admin API access is decided by the account's stored role, read live from
# Postgres on every request — not by this list and not by a token claim.
ADMIN_EMAILS=

# =============================================================================
# Auth tuning (optional)
# =============================================================================
# JWT_ISSUER=wa-gateway
# ACCESS_TOKEN_TTL=900          # seconds; 15 minutes
# REFRESH_TOKEN_TTL_DAYS=30
# DATABASE_POOL_MAX=10
# DATABASE_SSL=false            # true for a managed Postgres over the internet

# =============================================================================
# Frontend build values (single-origin deployment only)
# =============================================================================
# Vite inlines VITE_* at BUILD time, so these are only needed if you run
# `npm run build` on this server. They are not read at runtime.
#
# The frontend needs no Firebase config any more — authentication and data come
# from this backend. VITE_API_URL must be EMPTY for single-origin, so the app
# calls /api on its own host.
# VITE_API_URL=

# =============================================================================
# Mayar payment gateway
# =============================================================================
# Without MAYAR_WEBHOOK_TOKEN the webhook endpoint accepts unauthenticated
# calls, so set it in production.
MAYAR_API_KEY=
MAYAR_PAYMENT_LINK=
MAYAR_WEBHOOK_TOKEN=
