# Backend environment for the VPS.
# Copy to the project root as `.env` on the server and fill in real values.
#
#   cp deploy/.env.server.example .env
#
# Do NOT commit the real .env (it is already gitignored).

# Port the Node process listens on (nginx proxies to this).
PORT=5000

# Bind address. Keep 127.0.0.1 behind nginx so the app is not directly
# reachable from the internet. Use 0.0.0.0 only inside a container.
HOST=127.0.0.1

# Firebase project used to verify incoming ID tokens.
# Must match the project your frontend authenticates against.
FIREBASE_PROJECT_ID=whatsapp-omni-f2918

# Browser origins allowed to call this API. Comma-separated, no trailing slash.
# REQUIRED in production — leaving this unset allows every origin.
CORS_ORIGIN=https://your-frontend.vercel.app

NODE_ENV=production

# Public origin of the deployed app, e.g. https://app.omnireach.my.id
# Used as the post-payment return URL when a request carries no Referer.
PUBLIC_URL=

# --- Frontend build values (single-origin deployment only) --------------------
# Needed ONLY if you run `npm run build` on this server, because Vite inlines
# VITE_* values into the bundle at build time. If you build on your laptop and
# upload dist/, leave these out — they are not read at runtime.
#
# VITE_API_URL must be EMPTY for a single-origin deployment so the frontend calls
# /api on its own host.
# VITE_API_URL=
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# VITE_FIREBASE_MEASUREMENT_ID=
# VITE_ADMIN_EMAILS=

# Addresses allowed to call the /api/admin/* routes (live session monitor,
# force logout, server overview). Comma-separated.
#
# A caller must BOTH be on this list and have role "admin" in Firestore, which
# mirrors isAdmin() in firestore.rules. Keep this in sync with the allow-list
# there and in src/utils/adminAccess.js.
#
# owner@admin.com and adminthelab@gmail.com are always accepted as built-ins.
ADMIN_EMAILS=

# Mayar payment gateway. Without MAYAR_WEBHOOK_TOKEN the webhook endpoint
# accepts unauthenticated calls, so set it in production.
MAYAR_API_KEY=
MAYAR_PAYMENT_LINK=
MAYAR_WEBHOOK_TOKEN=
