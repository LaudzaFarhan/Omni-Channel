{
  "name": "whatsapp-business-dashboard",
  "version": "1.0.0",
  "description": "WhatsApp Business Dashboard using Baileys",
  "main": "server/index.js",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "server": "nodemon --ignore sessions/ --ignore *.json server/index.js",
    "client": "vite",
    "build": "vite build",
    "dev": "concurrently \"npm run server\" \"npm run client\""
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^0.395.0",
    "pg": "8.13.1",
    "pino": "^9.2.0",
    "qrcode": "^1.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "nodemon": "^3.1.3",
    "vite": "^5.3.1"
  }
}
