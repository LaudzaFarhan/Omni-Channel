rules_version = '2';

// Firestore security rules for the WhatsApp CRM.
//
// Deploy: Firebase Console -> Firestore Database -> Rules -> paste -> Publish.
//
// Design goals:
//  1. A user may read and lightly edit ONLY their own profile.
//  2. A user can never grant themselves privileges (role, approval, tier,
//     message/session limits). Those are admin-only fields.
//  3. Admin status is pinned to a known allow-list of emails verified by
//     Firebase Auth, not to a client-supplied field.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Admin allow-list. The email comes from the verified Firebase Auth token,
    // so it cannot be forged by the client.
    //
    // IMPORTANT: previously any address ending in "@admin.com" was treated as
    // admin, which meant anyone who registered such an address became an admin.
    // Add real admin addresses here instead.
    //
    // Keep in sync with src/utils/adminAccess.js (decides what the client writes
    // at signup) and ADMIN_EMAILS in the server environment (guards the
    // /api/admin routes). This function is the actual enforcement point.
    function isAdminEmail() {
      return isSignedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() in [
             'owner@admin.com',
             'adminthelab@gmail.com'
           ];
    }

    // A signup may only place itself on the plan an admin marked as the default.
    // 'free' stays accepted so registration keeps working before any plan
    // documents have been created.
    function isSignupPlan(planId) {
      return planId == 'free'
        || (
             exists(/databases/$(database)/documents/plans/$(planId))
             && get(/databases/$(database)/documents/plans/$(planId)).data.isDefault == true
           );
    }

    // Trusts the stored role, but only for accounts that are also on the
    // allow-list above, so a tampered role field alone grants nothing.
    function isAdmin() {
      return isAdminEmail()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{userId} {

      // --- READ ---
      // Own profile, or anything if you are an admin (needed by the registry).
      allow read: if isSelf(userId) || isAdmin();

      // --- CREATE (self-registration) ---
      // New accounts must start unprivileged: the customer role, unapproved, and
      // on the plan marked as the signup default. They also may not write their
      // own limit overrides, which would otherwise let a signup grant itself an
      // arbitrary quota. Admin bootstrap is permitted only for allow-listed
      // emails, so the first admin can still create a profile.
      allow create: if isSelf(userId) && (
        (
          request.resource.data.role == 'customer' &&
          request.resource.data.isApproved == false &&
          isSignupPlan(request.resource.data.tier) &&
          !request.resource.data.keys().hasAny(['messageLimit', 'sessionLimit', 'trialExpired'])
        )
        || isAdminEmail()
      );

      // --- UPDATE (self) ---
      // Users may rename themselves and increment their own usage counter by
      // exactly one. Everything else (role, isApproved, tier, messageLimit,
      // sessionLimit, trialExpired) is admin-only.
      allow update: if isSelf(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'messagesSent'])
        && (
             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['messagesSent'])
             || request.resource.data.messagesSent == resource.data.messagesSent + 1
           );

      // --- ADMIN full control ---
      allow update, delete: if isAdmin();
    }

    match /transactions/{txId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Plan catalogue (quota, device limit, price per tier).
    //
    // Readable by any signed-in user: the dashboard resolves the customer's
    // effective limits from their plan, and the backend reads the plan through
    // the REST API using the caller's own token when enforcing the device limit.
    // Only admins may define or change a plan.
    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
