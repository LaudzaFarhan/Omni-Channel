VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Addresses that receive the admin role at signup. Comma-separated.
# owner@admin.com and adminthelab@gmail.com are built in.
#
# This only decides what the client writes when an account is created. The real
# enforcement is isAdminEmail() in firestore.rules (for data access) and
# ADMIN_EMAILS in the backend environment (for the /api/admin routes) — all
# three lists must agree, or the admin console will load empty.
VITE_ADMIN_EMAILS=owner@admin.com

# Older single-address form, still honoured.
VITE_ADMIN_EMAIL=owner@admin.com
VITE_ADMIN_PASSWORD=your_password

# Backend (Express + Socket.IO + Baileys) base URL.
# Leave EMPTY for local development — Vite proxies /api and /socket.io to
# http://localhost:5000 automatically.
# For a deployed frontend, point this at the always-on host running
# `npm run server`. The WhatsApp backend holds a long-lived WebSocket, so it
# cannot run on serverless platforms like Vercel functions.
# Example: VITE_API_URL=https://my-wa-backend.up.railway.app
VITE_API_URL=
